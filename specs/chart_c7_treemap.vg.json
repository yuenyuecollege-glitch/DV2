{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "C7 — Hierarchical treemap of organisation mix among formal volunteers, General Social Survey 2025. Shares renormalized to 100%; parent sectors nest child types.",
  "width": 1040,
  "height": 560,
  "padding": 8,
  "autosize": { "type": "fit", "contains": "padding" },
  "data": [
    {
      "name": "tree",
      "url": "data/org_types_hierarchy.json",
      "transform": [
        { "type": "stratify", "key": "id", "parentKey": "parent" },
        {
          "type": "treemap",
          "field": "value",
          "sort": { "field": "value", "order": "descending" },
          "size": [{ "signal": "width" }, { "signal": "height" }],
          "paddingInner": 3,
          "paddingOuter": 5,
          "round": true
        }
      ]
    },
    {
      "name": "nodes",
      "source": "tree",
      "transform": [{ "type": "filter", "expr": "datum.depth === 1" }]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        { "type": "filter", "expr": "datum.depth === 2" },
        {
          "type": "formula",
          "as": "fill",
          "expr": "datum.tone === 'sport' ? '#00897b' : datum.tone === 'faith' ? '#8e24aa' : datum.tone === 'community' ? '#fb8c00' : '#546e7a'"
        },
        {
          "type": "formula",
          "as": "cx",
          "expr": "(datum.x0 + datum.x1) / 2"
        },
        {
          "type": "formula",
          "as": "cy",
          "expr": "(datum.y0 + datum.y1) / 2"
        },
        {
          "type": "formula",
          "as": "cellW",
          "expr": "datum.x1 - datum.x0"
        },
        {
          "type": "formula",
          "as": "cellH",
          "expr": "datum.y1 - datum.y0"
        },
        {
          "type": "formula",
          "as": "rotateLabel",
          "expr": "datum.cellW < 78 && datum.cellH > datum.cellW * 1.8"
        },
        {
          "type": "formula",
          "as": "showLabel",
          "expr": "(datum.rotateLabel && datum.cellH > 72) || (datum.cellW > 56 && datum.cellH > 28)"
        },
        {
          "type": "formula",
          "as": "stackLabel",
          "expr": "!datum.rotateLabel && datum.cellW < 140 && datum.cellH > 44"
        },
        {
          "type": "formula",
          "as": "labelText",
          "expr": "datum.stackLabel ? [datum.short, format(datum.value, '.0f') + '%'] : datum.short + ' ' + format(datum.value, '.0f') + '%'"
        },
        {
          "type": "formula",
          "as": "labelSpan",
          "expr": "datum.rotateLabel ? datum.cellH : datum.cellW"
        },
        {
          "type": "formula",
          "as": "labelChars",
          "expr": "datum.stackLabel ? length(datum.short) : length(datum.short) + length(format(datum.value, '.0f')) + 2"
        },
        {
          "type": "formula",
          "as": "labelSize",
          "expr": "clamp(min(14, (datum.labelSpan - 16) / max(1, datum.labelChars * 0.8)), 9, 14)"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": { "data": "nodes" },
      "encode": {
        "update": {
          "x": { "field": "x0" },
          "y": { "field": "y0" },
          "x2": { "field": "x1" },
          "y2": { "field": "y1" },
          "fill": { "value": "#e8ecea" },
          "stroke": { "value": "#f7f8f6" },
          "strokeWidth": { "value": 2 }
        }
      }
    },
    {
      "type": "rect",
      "from": { "data": "leaves" },
      "encode": {
        "enter": {
          "tooltip": {
            "signal": "datum.id + ' (' + datum.parent + '): ' + format(datum.value, '.1f') + '% of organisation mix'"
          }
        },
        "update": {
          "x": { "field": "x0" },
          "y": { "field": "y0" },
          "x2": { "field": "x1" },
          "y2": { "field": "y1" },
          "stroke": { "value": "#f7f8f6" },
          "strokeWidth": { "value": 1.5 },
          "fill": { "field": "fill" },
          "fillOpacity": { "value": 0.95 }
        },
        "hover": { "fillOpacity": { "value": 1 } }
      }
    },
    {
      "type": "text",
      "from": { "data": "leaves" },
      "encode": {
        "update": {
          "x": { "field": "cx" },
          "y": { "field": "cy" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "angle": {
            "signal": "datum.rotateLabel ? -90 : 0"
          },
          "text": {
            "signal": "datum.showLabel ? datum.labelText : ''"
          },
          "fill": { "value": "#f7f8f6" },
          "fontSize": { "field": "labelSize" },
          "lineHeight": {
            "signal": "datum.labelSize + 2"
          },
          "fontWeight": { "value": 600 }
        }
      }
    }
  ]
}
