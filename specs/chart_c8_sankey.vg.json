{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "C8 — Sankey: remoteness (left) to formal / not formal (right). Population-weighted ASGS shares × GSS 2025 rates.",
  "width": 456,
  "height": 480,
  "padding": { "left": 148, "right": 168, "top": 12, "bottom": 12 },
  "autosize": { "type": "none" },
  "data": [
    { "name": "nodes", "url": "data/sankey_remoteness_nodes.json" },
    { "name": "links", "url": "data/sankey_remoteness_links.json?v=20261024c8" }
  ],
  "marks": [
    {
      "type": "path",
      "from": { "data": "links" },
      "encode": {
        "enter": {
          "path": { "field": "path" },
          "strokeWidth": { "value": 0 },
          "tooltip": {
            "signal": "datum.label"
          }
        },
        "update": {
          "fill": { "field": "colour" },
          "fillOpacity": {
            "signal": "datum.highlight ? 0.95 : 0.72"
          }
        },
        "hover": { "fillOpacity": { "value": 0.98 } }
      }
    },
    {
      "type": "rect",
      "from": { "data": "nodes" },
      "encode": {
        "enter": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "width": { "field": "w" },
          "height": { "field": "h" },
          "fill": { "value": "#15202b" },
          "cornerRadius": { "value": 1 }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "nodes" },
      "encode": {
        "enter": {
          "x": { "field": "label_x" },
          "y": { "field": "mid_y" },
          "text": {
            "signal": "datum.name + '  ' + format(datum.value, '.1f') + '%'"
          },
          "align": { "field": "align" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 15 },
          "fontWeight": { "value": 600 },
          "fill": { "value": "#0d1b24" }
        }
      }
    }
  ]
}
