{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "C4 — Radial bar chart: formal volunteering rate by remoteness, General Social Survey 2025 Table 7.3. Labels and tooltips both use formal_rate_pct.",
  "width": 552,
  "height": 552,
  "padding": 0,
  "autosize": { "type": "none" },
  "signals": [
    { "name": "cx", "update": "width / 2" },
    { "name": "cy", "update": "height / 2" },
    { "name": "innerR", "update": "min(width, height) * 0.11" },
    { "name": "baseR", "update": "min(width, height) * 0.18" },
    { "name": "spanR", "update": "min(width, height) * 0.22" },
    { "name": "labelR", "update": "min(width, height) * 0.42" }
  ],
  "data": [
    {
      "name": "table",
      "url": "data/gss_formal_rate_by_remoteness.csv",
      "format": { "type": "csv", "parse": { "formal_rate_pct": "number" } },
      "transform": [
        { "type": "filter", "expr": "datum.remoteness !== 'Total'" },
        {
          "type": "formula",
          "as": "ord",
          "expr": "indexof(['Major cities', 'Inner regional', 'Outer regional', 'Remote'], datum.remoteness)"
        },
        { "type": "collect", "sort": { "field": "ord" } },
        {
          "type": "formula",
          "as": "tone",
          "expr": "datum.remoteness === 'Remote' ? 'highlight' : 'other'"
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["idx"]
        },
        {
          "type": "formula",
          "as": "theta0",
          "expr": "(datum.idx - 1) * (PI / 2) - PI / 2"
        },
        {
          "type": "formula",
          "as": "theta1",
          "expr": "datum.idx * (PI / 2) - PI / 2 - 0.08"
        },
        {
          "type": "formula",
          "as": "outer",
          "expr": "baseR + (datum.formal_rate_pct / 40) * spanR"
        },
        {
          "type": "formula",
          "as": "mid",
          "expr": "(datum.theta0 + datum.theta1) / 2"
        },
        {
          "type": "formula",
          "as": "rateLabel",
          "expr": "format(datum.formal_rate_pct, '.1f') + '%'"
        },
        {
          "type": "formula",
          "as": "labelText",
          "expr": "datum.remoteness + '\\n' + datum.rateLabel"
        },
        {
          "type": "formula",
          "as": "tooltipText",
          "expr": "datum.remoteness + ': formal volunteering rate ' + datum.rateLabel"
        },
        {
          "type": "formula",
          "as": "lx",
          "expr": "labelR * sin(datum.mid)"
        },
        {
          "type": "formula",
          "as": "ly",
          "expr": "-labelR * cos(datum.mid)"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["highlight", "other"],
      "range": ["#3949ab", "#c5cae9"]
    }
  ],
  "marks": [
    {
      "type": "arc",
      "from": { "data": "table" },
      "encode": {
        "enter": {
          "startAngle": { "field": "theta0" },
          "endAngle": { "field": "theta1" },
          "cornerRadius": { "value": 4 },
          "fill": { "scale": "color", "field": "tone" }
        },
        "update": {
          "x": { "signal": "cx" },
          "y": { "signal": "cy" },
          "innerRadius": { "signal": "innerR" },
          "outerRadius": { "field": "outer" },
          "tooltip": { "signal": "datum.tooltipText" }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "table" },
      "encode": {
        "enter": {
          "text": { "field": "labelText" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 14 },
          "fontWeight": { "value": 700 },
          "fill": { "value": "#0d1b24" },
          "lineBreak": { "value": "\n" },
          "lineHeight": { "value": 17 }
        },
        "update": {
          "x": { "signal": "cx + datum.lx" },
          "y": { "signal": "cy + datum.ly" },
          "tooltip": { "signal": "datum.tooltipText" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "text": { "value": "Formal\nrate" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 16 },
          "fontWeight": { "value": 650 },
          "fill": { "value": "#4a5863" },
          "lineBreak": { "value": "\n" },
          "lineHeight": { "value": 18 },
          "dy": { "value": -8 }
        },
        "update": {
          "x": { "signal": "cx" },
          "y": { "signal": "cy" }
        }
      }
    }
  ]
}
