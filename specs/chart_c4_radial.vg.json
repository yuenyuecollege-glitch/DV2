{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "C4 — Radial bar chart: formal volunteering rate by remoteness, General Social Survey 2025.",
  "width": 480,
  "height": 480,
  "padding": 70,
  "autosize": { "type": "pad", "contains": "padding" },
  "data": [
    {
      "name": "table",
      "url": "data/gss_formal_rate_by_remoteness.csv",
      "format": { "type": "csv", "parse": { "formal_rate_pct": "number" } },
      "transform": [
        { "type": "filter", "expr": "datum.remoteness !== 'Total'" },
        {
          "type": "formula",
          "as": "tone",
          "expr": "datum.remoteness === 'Remote' ? 'highlight' : 'other'"
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["idx"]
        },
        {
          "type": "formula",
          "as": "theta0",
          "expr": "(datum.idx - 1) * (PI / 2) - PI / 2"
        },
        {
          "type": "formula",
          "as": "theta1",
          "expr": "datum.idx * (PI / 2) - PI / 2 - 0.08"
        },
        {
          "type": "formula",
          "as": "outer",
          "expr": "70 + (datum.formal_rate_pct / 40) * 130"
        },
        {
          "type": "formula",
          "as": "labelR",
          "expr": "datum.outer + 44"
        },
        {
          "type": "formula",
          "as": "mid",
          "expr": "(datum.theta0 + datum.theta1) / 2"
        },
        {
          "type": "formula",
          "as": "lx",
          "expr": "datum.labelR * cos(datum.mid)"
        },
        {
          "type": "formula",
          "as": "ly",
          "expr": "datum.labelR * sin(datum.mid)"
        },
        {
          "type": "formula",
          "as": "labelAlign",
          "expr": "cos(datum.mid) > 0.15 ? 'left' : cos(datum.mid) < -0.15 ? 'right' : 'center'"
        },
        {
          "type": "formula",
          "as": "labelText",
          "expr": "datum.remoteness === 'Remote' ? 'Remote\\nWidest gap from cities' : datum.remoteness"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["highlight", "other"],
      "range": ["#ff6d00", "#3949ab"]
    }
  ],
  "marks": [
    {
      "type": "arc",
      "from": { "data": "table" },
      "encode": {
        "enter": {
          "x": { "signal": "width / 2" },
          "y": { "signal": "height / 2" },
          "startAngle": { "field": "theta0" },
          "endAngle": { "field": "theta1" },
          "innerRadius": { "value": 52 },
          "outerRadius": { "field": "outer" },
          "cornerRadius": { "value": 4 },
          "fill": { "scale": "color", "field": "tone" },
          "tooltip": {
            "signal": "datum.remoteness + ': formal volunteering rate ' + format(datum.formal_rate_pct, '.1f') + '%'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "table" },
      "encode": {
        "enter": {
          "x": { "signal": "width / 2 + datum.lx" },
          "y": { "signal": "height / 2 + datum.ly" },
          "text": { "field": "labelText" },
          "align": { "field": "labelAlign" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 13 },
          "fontWeight": { "value": 700 },
          "fill": { "value": "#0d1b24" },
          "lineBreak": { "value": "\\n" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": { "signal": "width / 2" },
          "y": { "signal": "height / 2" },
          "text": { "value": "Formal\nrate" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 14 },
          "fontWeight": { "value": 650 },
          "fill": { "value": "#4a5863" },
          "lineBreak": { "value": "\\n" }
        }
      }
    }
  ]
}
