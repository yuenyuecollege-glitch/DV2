{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C3 — Dot density of Census 2021 volunteers by state. Same Albers AU projection. 1 dot ≈ 10,000 volunteers.",
  "width": "container",
  "height": 560,
  "padding": { "left": 8, "right": 8, "top": 36, "bottom": 56 },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36],
    "scale": 580,
    "center": [0, -28]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8eef0",
        "stroke": "#b7c4c8",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/volunteer_dots.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "transform": [
        { "calculate": "datum.geometry.coordinates[0]", "as": "longitude" },
        { "calculate": "datum.geometry.coordinates[1]", "as": "latitude" },
        { "calculate": "datum.properties.state", "as": "state" },
        { "calculate": "datum.properties.dot_value", "as": "dot_value" }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 22,
        "fill": "#145a5c",
        "fillOpacity": 0.55,
        "stroke": null
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / territory" },
          { "field": "dot_value", "type": "quantitative", "title": "People per dot", "format": "," }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 112.5,
            "latitude": -39.8,
            "label": "1 dot ≈ 10,000 volunteers"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "align": "left"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#15202b" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}
