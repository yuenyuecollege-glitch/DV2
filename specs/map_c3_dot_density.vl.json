{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C3 — Dot density of Census 2021 volunteers by state. Same Albers Australia projection. One dot about 10,000 volunteers.",
  "width": "container",
  "height": 680,
  "padding": { "left": 4, "right": 4, "top": 12, "bottom": 44 },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36],
    "scale": 980,
    "center": [0, -27.5]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8f5f6",
        "stroke": "#80cbc4",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/volunteer_dots.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "transform": [
        { "calculate": "datum.geometry.coordinates[0]", "as": "longitude" },
        { "calculate": "datum.geometry.coordinates[1]", "as": "latitude" },
        { "calculate": "datum.properties.state", "as": "state" },
        { "calculate": "datum.properties.dot_value", "as": "dot_value" }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 18,
        "fill": "#00838f",
        "fillOpacity": 0.62,
        "stroke": null
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State or territory" },
          { "field": "dot_value", "type": "quantitative", "title": "People represented by each dot", "format": "," }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 114.0,
            "latitude": -41.5,
            "label": "1 dot = 10,000 volunteers"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": 700,
        "align": "left"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#004d40" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null }
  }
}
