{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C10 — Line of total formal volunteer hours, 2019–2025.",
  "width": "container",
  "height": 420,
  "padding": { "left": 8, "right": 24, "top": 36, "bottom": 16 },
  "data": { "url": "data/gss_formal_hours_trend.csv" },
  "transform": [
    {
      "calculate": "datum.year === 2020 ? 'dip' : datum.year === 2025 ? 'peak' : 'other'",
      "as": "tone"
    },
    {
      "calculate": "datum.year === 2020 ? 'Pandemic low point' : datum.year === 2025 ? 'Hours above the 2019 level' : ''",
      "as": "insight"
    }
  ],
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 4.5, "color": "#2e7d32" },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": { "labelAngle": 0, "labelFontWeight": 600 }
        },
        "y": {
          "field": "total_hours_million",
          "type": "quantitative",
          "title": "Total formal volunteer hours (millions)",
          "scale": { "domain": [400, 720] }
        },
        "tooltip": [
          { "field": "year", "type": "ordinal", "title": "Year" },
          {
            "field": "total_hours_million",
            "type": "quantitative",
            "title": "Total hours (millions)",
            "format": ".1f"
          },
          { "field": "note", "type": "nominal", "title": "Source note" }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 280,
        "opacity": 1,
        "stroke": "#f5f7f4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "total_hours_million", "type": "quantitative" },
        "color": {
          "field": "tone",
          "type": "nominal",
          "scale": {
            "domain": ["dip", "peak", "other"],
            "range": ["#ff7043", "#2e7d32", "#81c784"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [{ "filter": "datum.insight !== ''" }],
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "total_hours_million", "type": "quantitative" },
        "text": { "field": "insight" },
        "color": {
          "condition": { "test": "datum.tone === 'dip'", "value": "#bf360c" },
          "value": "#1b5e20"
        }
      }
    }
  ]
}
