{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C11 — Unit / waffle: General Social Survey 2025 formal vs Census 2021 volunteering.",
  "data": { "url": "data/waffle_compare.csv" },
  "transform": [
    {
      "calculate": "datum.status === 'volunteer' ? 'Volunteered' : 'Did not volunteer'",
      "as": "status_label"
    }
  ],
  "padding": { "left": 12, "right": 12, "top": 8, "bottom": 8 },
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "sort": [
        "General Social Survey 2025 · about 23 in 100",
        "Census 2021 · about 14 in 100"
      ],
      "header": {
        "title": null,
        "labelFontSize": 17,
        "labelFontWeight": 600,
        "labelPadding": 12,
        "labelLimit": 0,
        "labelAlign": "center"
      }
    }
  },
  "spec": {
    "width": 440,
    "height": 440,
    "mark": {
      "type": "rect",
      "stroke": "#f5f7f4",
      "strokeWidth": 2,
      "cornerRadius": 2
    },
    "encoding": {
      "x": { "field": "col", "type": "ordinal", "axis": null },
      "y": { "field": "row", "type": "ordinal", "axis": null },
      "color": {
        "field": "status",
        "type": "nominal",
        "scale": {
          "domain": ["volunteer", "not"],
          "range": ["#1565c0", "#cfd8dc"]
        },
        "legend": {
          "title": null,
          "orient": "bottom",
          "labelExpr": "datum.value === 'volunteer' ? 'Volunteered' : 'Did not volunteer'"
        }
      },
      "tooltip": [
        { "field": "panel", "type": "nominal", "title": "Survey" },
        { "field": "status_label", "type": "nominal", "title": "Cell" }
      ]
    }
  },
  "resolve": { "scale": { "color": "shared" } },
  "config": {
    "view": { "stroke": null }
  }
}
