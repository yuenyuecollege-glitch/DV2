{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C9 — Heatmap of annual hours band by age among formal volunteers, General Social Survey 2025.",
  "width": "container",
  "height": 420,
  "padding": { "left": 8, "right": 8, "top": 16, "bottom": 16 },
  "data": { "url": "data/gss_hours_by_age_heatmap.csv" },
  "layer": [
    {
      "mark": { "type": "rect", "stroke": "#f5f7f4", "strokeWidth": 2 },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"],
          "title": null
        },
        "x": {
          "field": "hours_band",
          "type": "nominal",
          "sort": ["1-20 hours", "21-99 hours", "100 hours or more"],
          "title": "Hours in the prior 12 months",
          "axis": { "labelAngle": 0 }
        },
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "range": ["#fce4ec", "#f48fb1", "#ec407a", "#c2185b", "#880e4f"],
            "domain": [15, 55]
          },
          "legend": {
            "title": "Share of age group (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200
          }
        },
        "tooltip": [
          { "field": "age_group", "type": "nominal", "title": "Age group" },
          { "field": "hours_band", "type": "nominal", "title": "Hours band" },
          { "field": "share_pct", "type": "quantitative", "title": "Share of age group (%)", "format": ".1f" }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_group === '65 years and over' && datum.hours_band === '100 hours or more'"
        }
      ],
      "mark": {
        "type": "rect",
        "filled": false,
        "stroke": "#1565c0",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"]
        },
        "x": {
          "field": "hours_band",
          "type": "nominal",
          "sort": ["1-20 hours", "21-99 hours", "100 hours or more"]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_group === '65 years and over' && datum.hours_band === '100 hours or more'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "dy": -28,
        "align": "center"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"]
        },
        "x": {
          "field": "hours_band",
          "type": "nominal",
          "sort": ["1-20 hours", "21-99 hours", "100 hours or more"]
        },
        "text": { "value": "Long hours concentrate here" },
        "color": { "value": "#1565c0" }
      }
    }
  ]
}
