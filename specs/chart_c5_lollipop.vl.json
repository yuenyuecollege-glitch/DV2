{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C5 — Lollipop of formal volunteering rate by age, General Social Survey 2025.",
  "width": "container",
  "height": 420,
  "padding": { "left": 8, "right": 120, "top": 16, "bottom": 16 },
  "data": { "url": "data/gss_formal_rate_by_age.csv" },
  "transform": [
    {
      "calculate": "datum.age_group === '45-54' || datum.age_group === '25-34' ? 'highlight' : 'other'",
      "as": "tone"
    },
    {
      "calculate": "datum.age_group === '45-54' ? 'Peak mid-life band' : datum.age_group === '25-34' ? 'Softest working-age band' : ''",
      "as": "insight"
    }
  ],
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 3.6 },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"],
          "title": null
        },
        "x": { "field": "formal_rate_pct", "type": "quantitative" },
        "x2": { "datum": 0 },
        "color": {
          "field": "tone",
          "type": "nominal",
          "scale": { "domain": ["highlight", "other"], "range": ["#6a1b9a", "#b39ddb"] },
          "legend": null
        }
      }
    },
    {
      "mark": { "type": "circle", "filled": true, "size": 260, "opacity": 1 },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"]
        },
        "x": {
          "field": "formal_rate_pct",
          "type": "quantitative",
          "title": "Formal volunteering rate (%)",
          "scale": { "domain": [0, 42] }
        },
        "color": {
          "field": "tone",
          "type": "nominal",
          "scale": { "domain": ["highlight", "other"], "range": ["#6a1b9a", "#b39ddb"] },
          "legend": null
        },
        "tooltip": [
          { "field": "age_group", "type": "nominal", "title": "Age group" },
          { "field": "formal_rate_pct", "type": "quantitative", "title": "Formal volunteering rate (%)", "format": ".1f" },
          { "field": "informal_rate_pct", "type": "quantitative", "title": "Informal volunteering rate (%)", "format": ".1f" }
        ]
      }
    },
    {
      "transform": [
        { "filter": "datum.insight !== ''" }
      ],
      "mark": {
        "type": "text",
        "dx": 14,
        "align": "left",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": ["15-24", "25-34", "35-44", "45-54", "55-64", "65 years and over"]
        },
        "x": { "field": "formal_rate_pct", "type": "quantitative" },
        "text": { "field": "insight" },
        "color": { "value": "#4a148c" }
      }
    }
  ]
}
