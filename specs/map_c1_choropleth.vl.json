{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C1 — Choropleth of Census 2021 formal volunteering rate (%) by SA4. Albers / conic equal-area for Australia.",
  "width": "container",
  "height": 560,
  "padding": { "left": 8, "right": 8, "top": 36, "bottom": 64 },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36],
    "scale": 600,
    "center": [0, -28]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_sa4.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "transform": [
        { "calculate": "datum.properties.sa4_name", "as": "sa4_name" },
        { "calculate": "datum.properties.rate_pct", "as": "rate_pct" },
        { "calculate": "datum.properties.volunteers", "as": "volunteers" }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f7f8f6",
        "strokeWidth": 0.45
      },
      "encoding": {
        "color": {
          "field": "rate_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "tealblues",
            "domainMin": 6,
            "domainMax": 27
          },
          "legend": {
            "title": "Volunteering rate (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "offset": 8,
            "format": ".0f"
          }
        },
        "tooltip": [
          { "field": "sa4_name", "type": "nominal", "title": "SA4 region" },
          { "field": "rate_pct", "type": "quantitative", "title": "Rate (%)", "format": ".1f" },
          { "field": "volunteers", "type": "quantitative", "title": "Volunteers", "format": "," }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 117.0,
            "latitude": -31.2,
            "label": "Wheat Belt 26.8%"
          },
          {
            "longitude": 151.0,
            "latitude": -34.1,
            "label": "Sydney SW 6.8%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 4
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#15202b" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "legend": { "padding": 4 }
  }
}
