{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C2 — Proportional symbol map of Census 2021 volunteer counts by state and territory. Same Albers Australia projection as C1.",
  "width": "container",
  "height": 680,
  "padding": { "left": 4, "right": 4, "top": 8, "bottom": 68 },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36],
    "scale": 980,
    "center": [0, -27.5]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d0ecef",
        "stroke": "#f5f7f4",
        "strokeWidth": 1
      }
    },
    {
      "data": { "url": "data/state_volunteer_centroids.csv" },
      "mark": {
        "type": "circle",
        "filled": true,
        "fill": "#00838f",
        "fillOpacity": 0.7,
        "stroke": "#004d40",
        "strokeWidth": 0.9
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "size": {
          "field": "volunteers",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "range": [60, 1600]
          },
          "legend": {
            "title": "Number of volunteers",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [50000, 300000, 800000],
            "format": ",.0f",
            "offset": 4,
            "symbolFillColor": "#00838f",
            "symbolStrokeColor": "#004d40"
          }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State or territory" },
          { "field": "volunteers", "type": "quantitative", "title": "Number of volunteers", "format": "," },
          { "field": "rate_pct", "type": "quantitative", "title": "Volunteering rate (%)", "format": ".1f" }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 148.5,
            "latitude": -30.5,
            "label": "Largest pools sit in the south east"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": 700,
        "align": "left"
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "label" },
        "color": { "value": "#004d40" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "legend": { "padding": 4 }
  }
}
