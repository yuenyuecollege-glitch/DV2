{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C2 — Proportional symbol map of Census 2021 volunteer counts by state/territory. Same Albers AU projection as C1.",
  "width": "container",
  "height": 560,
  "padding": { "left": 8, "right": 8, "top": 36, "bottom": 80 },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36],
    "scale": 580,
    "center": [0, -28]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d9e3e6",
        "stroke": "#f7f8f6",
        "strokeWidth": 1
      }
    },
    {
      "data": { "url": "data/state_volunteer_centroids.csv" },
      "mark": {
        "type": "circle",
        "filled": true,
        "fill": "#0f6b6d",
        "fillOpacity": 0.78,
        "stroke": "#0a4547",
        "strokeWidth": 0.9
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "size": {
          "field": "volunteers",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [100, 3200]
          },
          "legend": {
            "title": "Volunteers",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [50000, 300000, 800000],
            "format": ",.0s",
            "offset": 8,
            "symbolFillColor": "#0f6b6d",
            "symbolStrokeColor": "#0a4547"
          }
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / territory" },
          { "field": "volunteers", "type": "quantitative", "title": "Volunteers", "format": "," },
          { "field": "rate_pct", "type": "quantitative", "title": "Rate (%)", "format": ".1f" }
        ]
      }
    },
    {
      "data": { "url": "data/state_volunteer_centroids.csv" },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "dy": -1
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "text": { "field": "state_abbr" },
        "color": { "value": "#15202b" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "legend": { "padding": 4 }
  }
}
