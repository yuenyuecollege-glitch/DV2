{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C6 — Line of formal volunteering rate, 2019–2025 (General Social Survey). Short time series suits a line, not a waterfall.",
  "width": "container",
  "height": 420,
  "padding": { "left": 8, "right": 28, "top": 28, "bottom": 16 },
  "data": { "url": "data/gss_formal_rate_trend.csv" },
  "transform": [
    { "filter": "datum.year >= 2019" },
    {
      "calculate": "datum.year === 2019 ? 'start' : datum.year === 2025 ? 'end' : 'mid'",
      "as": "tone"
    }
  ],
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 4.5, "color": "#2e7d32" },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": { "labelAngle": 0, "labelFontWeight": 600 }
        },
        "y": {
          "field": "formal_rate_pct",
          "type": "quantitative",
          "title": "Formal volunteering rate (%)",
          "scale": { "domain": [18, 35] }
        },
        "tooltip": [
          { "field": "year", "type": "ordinal", "title": "Year" },
          {
            "field": "formal_rate_pct",
            "type": "quantitative",
            "title": "Formal volunteering rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 280,
        "opacity": 1,
        "stroke": "#f5f7f4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "formal_rate_pct", "type": "quantitative" },
        "color": {
          "field": "tone",
          "type": "nominal",
          "scale": {
            "domain": ["start", "mid", "end"],
            "range": ["#66bb6a", "#ff7043", "#2e7d32"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [{ "filter": "datum.year === 2025" }],
      "mark": {
        "type": "text",
        "dx": 12,
        "align": "left",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "formal_rate_pct", "type": "quantitative" },
        "text": { "value": "Still below the 2019 level" },
        "color": { "value": "#1b5e20" }
      }
    }
  ]
}
