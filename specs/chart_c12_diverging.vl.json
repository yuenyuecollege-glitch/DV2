{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C12 — Diverging bars: reasons for vs against formal volunteering, GSS 2025.",
  "width": "container",
  "height": 520,
  "padding": { "left": 8, "right": 40, "top": 28, "bottom": 16 },
  "data": { "url": "data/reasons_diverging.csv" },
  "transform": [
    {
      "calculate": "datum.polarity === 'for' ? 'For volunteering' : 'Against volunteering'",
      "as": "side"
    },
    {
      "calculate": "datum.reason === 'Help others or community' || datum.reason === 'No time' ? 1 : 0.72",
      "as": "bar_opacity"
    }
  ],
  "mark": { "type": "bar", "cornerRadiusEnd": 3 },
  "encoding": {
    "y": {
      "field": "reason",
      "type": "nominal",
      "sort": { "field": "signed_pct", "order": "descending" },
      "title": null,
      "axis": { "labelLimit": 0 }
    },
    "x": {
      "field": "signed_pct",
      "type": "quantitative",
      "title": "Share of people (%): left not volunteering · right volunteering",
      "axis": { "labelExpr": "replace(format(datum.value, 'd'), '-', '')" }
    },
    "color": {
      "field": "side",
      "type": "nominal",
      "scale": {
        "domain": ["For volunteering", "Against volunteering"],
        "range": ["#00897b", "#e65100"]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "horizontal",
        "columns": 2,
        "labelLimit": 0
      }
    },
    "opacity": { "field": "bar_opacity", "type": "quantitative", "legend": null },
    "tooltip": [
      { "field": "reason", "type": "nominal" },
      { "field": "side", "type": "nominal" },
      { "field": "pct", "type": "quantitative", "title": "Share (%)", "format": ".1f" }
    ]
  }
}
